<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity android:name="com.tnkfactory.offerrer.scene.TnkEmbedActivity" />
        <activity
            android:name="com.tnkfactory.ad.AdWallActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="screenSize|smallestScreenSize|orientation|screenLayout|keyboardHidden|uiMode" />
        <!-- configChanges : 모든 매체에 권장합니다. 화면 회전이나 단말 다크모드 전환 때 Activity 가 재생성되어
             오퍼월이 처음 화면으로 돌아가는 것을 막습니다. -->
    </application>
</manifest>